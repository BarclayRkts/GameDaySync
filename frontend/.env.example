# Optional local override for the API origin. The default is http://localhost:5123
# locally and https://gamedaysync.onrender.com in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5123

# Server-only token used by dashboard pipeline trigger buttons. It must match the
# CRON_SECRET_TOKEN configured for the backend and must not use a NEXT_PUBLIC_ prefix.
CRON_SECRET_TOKEN=
